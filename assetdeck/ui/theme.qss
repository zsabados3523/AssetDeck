/* Folha de estilo do AssetDeck.
 *
 * NÃO é um arquivo QSS comum: os "$$nome" são tokens substituídos por
 * `theme.build_qss()`. Nunca escreva uma cor literal aqui — acrescente um
 * token em `theme.py`. Um "$$" solto levanta erro na hora (de propósito);
 * para escrever um cifrão literal, dobre-o como nesta própria frase.
 *
 * Duas regras que NÃO podem ser quebradas, medidas no Qt do projeto:
 *
 *  1. NÃO estilizar `QListView::item`. Isso joga a pintura da grade para o
 *     QStyleSheetStyle item a item e mata a rolagem com centenas de assets.
 *     O visual do card é responsabilidade do delegate (Fatia 27).
 *  2. NÃO estilizar subcontrole (::drop-down, ::indicator, ::branch) sem
 *     fornecer a `image:` de reposição — a seta do combo e o quadrinho do
 *     checkbox somem. Enquanto não houver SVG (Fatia 26), eles ficam com o
 *     desenho do Fusion, que a paleta já colore corretamente.
 */

/* ---------------------------------------------------------------- base -- */

QWidget {
    color: $text;
    font-size: $font_size;
}

QMainWindow {
    background-color: $bg;
}

/* QDialog NÃO arredonda (tentado e revertido — ver theme.py). Ao contrário
 * de QMenu, um QDialog normal GANHA barra de título nativa do gerenciador de
 * janelas (minimizar/maximizar/fechar) — cortar cantos por baixo dela deixa
 * uma costura feia onde o retângulo quadrado da barra encontra o corpo
 * arredondado (visto na tela pelo Rafael). QMenu não tem esse problema (é
 * uma janela popup sem decoração nenhuma), então continua arredondado. */
QDialog {
    background-color: $bg;
}

/* Superfície de fundo da janela. É o widget central que recebe o fundo, e não
 * o QMainWindow: o QMainWindow tem tratamento próprio de fundo e deu resultado
 * inconsistente no teste. */
QWidget#appSurface {
    background-color: $bg;
    $bg_image
}

/* --------------------------------------------------------------- cards -- */

/* Até a Fatia 43 fundo e painel eram os DOIS brancos, separados só por uma
 * linha quase invisível — e a tela saía chapada. Na Fatia 44 o painel
 * ($surface) passou a ser um degrau mais claro que o fundo ($bg) no modo
 * claro, e mais claro que o quase-preto no escuro. A linha e a sombra
 * continuam, agora reforçando um degrau que já existe em vez de o inventarem
 * sozinhas.
 * Toda view (árvore, lista, grade) mora DENTRO de um destes, porque o
 * viewport de uma view pinta retângulo no canto e vaza por cima de qualquer
 * border-radius aplicado nela diretamente. */
QFrame#card {
    background-color: $surface;
    border: 1px solid $hairline;
    border-radius: $radius_panel;
}

QFrame#cardFlat {
    background-color: $surface;
    border: 1px solid $border;
    border-radius: $radius_card;
}

/* Traço fino separando grupos na barra do breadcrumb (Fatia 43) — largura
 * fixa 1px definida em Python, aqui só a cor. */
QFrame#breadcrumbDivider {
    background-color: $hairline;
}

/* Cabeçalho da lista (faixa 3 do topo, Fatia 46): o escopo em destaque e a
 * contagem apagada ao lado. O contraste entre os dois é o que faz a linha ser
 * lida como "título + apoio" em vez de duas informações concorrendo. */
QLabel#listScope {
    color: $title;
    font-size: $font_size;
    font-weight: 600;
}

QLabel#listCount {
    color: $text_muted;
    font-size: $font_size_small;
}

/* -------------------------------------------------------------- lateral -- */

/* Rail: coluna estreita de ícones, um por seção (Fatia 45). Fica no tom do
 * FUNDO, não da superfície — é ele que faz o painel das seções parecer
 * apoiado em cima de alguma coisa em vez de flutuar solto. */
QWidget#sidebarRail {
    background-color: $bg;
}

QToolButton#railButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: $radius_control;
    padding: 6px;
}

QToolButton#railButton:hover {
    background-color: $surface_hover;
}

/* Sem pastilha no estado marcado, ao contrário dos outros QToolButton do app:
 * "seção visível" é o estado normal das quatro, e acender as quatro deixaria
 * o rail permanentemente iluminado sem dizer nada. O que o rail comunica é a
 * exceção — seção escondida, ícone apagado (tingido em Python, ver
 * SidebarRail.refresh_theme). */
QToolButton#railButton:checked {
    background: transparent;
    border: 1px solid transparent;
}

/* Cabeçalho de seção: a linha inteira é clicável (recolhe/expande). */
QWidget#sidebarHeader {
    background: transparent;
    border-radius: $radius_control;
}

QWidget#sidebarHeader:hover {
    background-color: $surface_hover;
}

QLabel#sidebarSectionTitle {
    color: $text_muted;
    font-size: $font_size_small;
    font-weight: 700;
    letter-spacing: 1px;
}

/* Contador: mais apagado que o título de propósito. É informação de apoio —
 * se competir com o nome da seção, a lateral vira uma tabela de números. */
QLabel#sidebarCount {
    color: $text_disabled;
    font-size: $font_size_small;
    font-weight: 600;
}

/* QScrollArea em si (moldura/fundo do viewport é responsabilidade do Python
 * — ver `scroll.viewport().setAutoFillBackground(False)` em details_panel.py;
 * o seletor `QScrollArea > QWidget` do QSS NÃO alcança o viewport de forma
 * confiável, então não dá pra resolver só daqui). */
QScrollArea {
    background: transparent;
    border: none;
}

/* ---------------------------------------------------------------- texto -- */

QLabel {
    background: transparent;
}

QLabel#sectionTitle {
    color: $text_muted;
    font-size: $font_size_small;
    font-weight: 600;
}

QLabel#title {
    color: $title;
    font-size: $font_size_title;
    font-weight: 600;
}

QLabel#muted, QLabel#previewInfo {
    color: $text_muted;
}

QLabel#multiWarn {
    color: $warning;
    font-weight: 600;
}

QLabel#danger {
    color: $danger;
}

QLabel:disabled {
    color: $text_disabled;
}

/* -------------------------------------------------------------- campos -- */

QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QDateEdit {
    background-color: $field;
    border: 1px solid $border;
    border-radius: $radius_control;
    padding: $pad_m;
    color: $text;
    selection-background-color: $accent;
    selection-color: $on_accent;
}

QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus {
    border: 1px solid $focus;
}

QLineEdit:disabled, QPlainTextEdit:disabled, QTextEdit:disabled {
    color: $text_disabled;
}

/* -------------------------------------------------------------- botões -- */

QPushButton, QToolButton {
    background-color: $surface;
    border: 1px solid $border;
    border-radius: $radius_control;
    padding: $pad_m $pad_l;
    color: $text;
}

QPushButton:hover, QToolButton:hover {
    background-color: $surface_hover;
    border: 1px solid $hairline;
}

/* Pressionado (transitório) segue monocromático: é um flash de meio segundo,
 * não vale acender o azul. */
QPushButton:pressed, QToolButton:pressed {
    background-color: $selection;
    border: 1px solid transparent;
    color: $text;
}

/* Marcado (persistente) é pastilha azul com o texto no destaque — Fatia 44.
 * É o estado que responde "qual filtro está ligado agora": era cinza sobre
 * cinza, e o Rafael não conseguia dizer, olhando a barra de categorias, o que
 * estava ativo. Aqui o azul carrega informação, que é a única condição em que
 * este projeto gasta cor. */
QPushButton:checked, QToolButton:checked {
    background-color: $accent_soft;
    border: 1px solid transparent;
    color: $accent;
    font-weight: 600;
}

QPushButton:disabled, QToolButton:disabled {
    color: $text_disabled;
    background-color: $surface;
}

/* Só UM botão principal por tela (é o que dá hierarquia). */
QPushButton#primary {
    background-color: $accent;
    border: 1px solid $accent;
    color: $on_accent;
    font-weight: 600;
}

QPushButton#primary:hover {
    background-color: $accent_hover;
    border: 1px solid $accent_hover;
}

QPushButton#primary:pressed {
    background-color: $accent_press;
    border: 1px solid $accent_press;
}

/* Botão sem moldura, para ações discretas (estrelas, ícones do painel). */
QPushButton#ghost, QToolButton#ghost {
    background: transparent;
    border: 1px solid transparent;
}

QPushButton#ghost:hover, QToolButton#ghost:hover {
    background-color: $surface_hover;
    border: 1px solid $hairline;
}

QCheckBox, QRadioButton {
    background: transparent;
    color: $text;
    spacing: 7px;
    padding: 2px 0;
}

/* Barra de busca (Fatia 28d): controles mais baixos SÓ aqui — pedido do
 * Rafael de enxutar verticalmente. objectName próprio, não afeta o resto
 * do app. */
#searchBar QLineEdit, #searchBar QPushButton {
    padding: 4px 10px;
}

#searchBar QCheckBox {
    padding: 0;
}

QCheckBox:disabled, QRadioButton:disabled {
    color: $text_disabled;
}

/* Exceção consciente à regra "não estilizar subcontrole sem repor a image:".
 * Com a paleta clara, o indicador que o Fusion desenha usa a cor de botão —
 * quase branco sobre quase branco — e a caixa DESMARCADA fica invisível na
 * tela. Aqui o estado é legível pelo preenchimento: cheio da cor de destaque =
 * marcado, vazio com borda = desmarcado.
 *
 * O fundo da caixa VAZIA era "#FFFFFF" cravado aqui — branco puro no meio de
 * uma janela quase preta, um confete aceso em cada checkbox do modo escuro
 * (Fatia 44). Agora é o token do campo, que acompanha o modo. */
QCheckBox::indicator, QRadioButton::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid $border_strong;
    background-color: $field;
}

QCheckBox::indicator {
    border-radius: 4px;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border: 1px solid $focus;
}

QCheckBox::indicator:checked {
    background-color: $accent;
    border: 1px solid $accent;
    image: url($check_icon);
}

/* Radio marcado é um ponto sólido, não um "✓" — a checkmark cairia estranho
 * dentro de um círculo. */
QRadioButton::indicator:checked {
    background-color: $accent;
    border: 1px solid $accent;
}

QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    border: 1px solid $border;
    background-color: $bg_tint;
}

/* O MESMO indicador, mas para os checkboxes DENTRO de árvores/listas/tabelas
 * (tags do painel de detalhes, TagTree lateral, DuplicatesDialog). É um
 * subcontrole diferente de QCheckBox::indicator — sem esta regra ele cai no
 * desenho genérico do QStyleSheetStyle assim que QUALQUER stylesheet está
 * ativo, que sai um quadrado preto sólido, marcado ou não (bug relatado pelo
 * Rafael, visto na tela: tags_tree do painel de detalhes). QTableView entrou
 * junto — mesmo bug, achado no DuplicatesDialog. */
QTreeView::indicator, QListView::indicator, QTableView::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid $border_strong;
    background-color: $field;
    border-radius: 4px;
}

QTreeView::indicator:checked, QListView::indicator:checked, QTableView::indicator:checked {
    background-color: $accent;
    border: 1px solid $accent;
    image: url($check_icon);
}

QTreeView::indicator:disabled, QListView::indicator:disabled, QTableView::indicator:disabled {
    border: 1px solid $border;
    background-color: $bg_tint;
}

QComboBox {
    background-color: $surface;
    border: 1px solid $border;
    border-radius: $radius_control;
    padding: $pad_m $pad_l;
    color: $text;
}

QComboBox:hover {
    background-color: $surface_hover;
}

QComboBox:focus {
    border: 1px solid $focus;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox::down-arrow {
    image: url($chevron_icon);
    width: 11px;
    height: 11px;
}

/* O popup do combo é uma JANELA separada: não herda o fundo do card e
 * ficaria branco-padrão sem esta regra. */
QComboBox QAbstractItemView {
    background-color: $popover;
    border: 1px solid $border;
    border-radius: $radius_control;
    padding: $pad_s;
    color: $text;
    selection-background-color: $selection;
    selection-color: $text;
    outline: none;
}

/* --------------------------------------------------------------- views -- */

/* Fundo transparente porque quem pinta a superfície é o QFrame#card em volta.
 * `QListView` aparece aqui só para zerar moldura e fundo — nunca com ::item. */
QTreeView, QTreeWidget, QListView, QListWidget, QTableView, QTableWidget {
    background: transparent;
    border: none;
    color: $text;
    outline: none;
    selection-background-color: $selection;
    selection-color: $text;
}

QTreeView::item, QListWidget::item, QTableView::item {
    padding: 4px 6px;
}

QTreeView::item:hover, QListWidget::item:hover, QTableView::item:hover {
    background-color: $surface_hover;
}

/* Seleção em pastilha CLARA com o texto na cor, como os botões ativos do
 * painel direito do Craft. A barra sólida de petróleo que estava aqui antes
 * dominava a tela inteira — foi o que o Rafael reprovou. */
QTreeView::item:selected, QListWidget::item:selected, QTableView::item:selected {
    background-color: $selection;
    color: $text;
}

/* Seleção arredondada só onde NÃO há coluna de indicador (as listas).
 * Na árvore, o indicador de expandir é pintado quadrado pelo estilo e fica um
 * degrau visível ao lado do item arredondado — medido pixel a pixel. Estilizar
 * `QTreeView::branch` para corrigir é pior: o Qt volta a pintar a seleção com
 * o azul padrão dele. Então a árvore usa barra de linha inteira, de propósito. */
QListWidget::item {
    border-radius: $radius_control;
}

QHeaderView::section {
    background-color: $bg_tint;
    border: none;
    border-bottom: 1px solid $border;
    padding: 6px 8px;
    color: $text_muted;
    font-weight: 600;
}

/* --------------------------------------------------------------- menus -- */

QMenuBar {
    background: transparent;
    color: $text;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 10px;
    border-radius: $radius_control;
}

QMenuBar::item:selected {
    background-color: $surface_hover;
}

QMenu {
    background-color: $popover;
    border: 1px solid $border;
    border-radius: $radius_card;
    padding: $pad_s;
    color: $text;
}

QMenu::item {
    padding: 6px 22px 6px 12px;
    border-radius: $radius_control;
}

QMenu::item:selected {
    background-color: $selection;
    color: $text;
}

QMenu::item:disabled {
    color: $text_disabled;
}

QMenu::separator {
    height: 1px;
    background-color: $border;
    margin: 5px 8px;
}

QToolTip {
    background-color: $popover;
    border: 1px solid $border;
    border-radius: $radius_control;
    padding: 5px 8px;
    color: $text;
}

/* ------------------------------------------------------------- rolagem -- */

QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 0;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background-color: $bg_tint;
    border-radius: 6px;
    min-height: 32px;
    min-width: 32px;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background-color: $selection;
}

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* ------------------------------------------------------------- diversos -- */

/* Barra fina e SEM texto por dentro: a porcentagem escrita por cima do trecho
 * preenchido fica com contraste de 2,4:1 contra o petróleo — ilegível. Quem
 * precisar do número escreve num QLabel ao lado. */
QProgressBar {
    background-color: $bg_tint;
    border: none;
    border-radius: 5px;
    min-height: 10px;
    max-height: 10px;
    color: $text_muted;
}

QProgressBar::chunk {
    background-color: $accent;
    border-radius: 5px;
}

/* Slider de tamanho da miniatura (Fatia 28c): trilho fino, alça pequena e
 * redonda, trecho preenchido na cor de destaque — minimalista, sem o relevo
 * 3D padrão do Fusion. */
QSlider::groove:horizontal {
    height: 4px;
    background: $bg_tint;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: $accent;
    border-radius: 2px;
}

/* A alça era "#FFFFFF" cravada — mesma história do checkbox: uma bolinha
 * branca acesa no rodapé escuro (Fatia 44). */
QSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    margin: -6px 0;
    background: $surface;
    border: 1px solid $border_strong;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    border: 1px solid $accent;
}

QSplitter::handle {
    background: transparent;
}

QSplitter::handle:hover {
    background-color: $selection;
}

/* Compacto de propósito (pedido do Rafael): é uma linha de status, não
 * precisa da altura padrão do Fusion. */
QStatusBar {
    background: transparent;
    color: $text_muted;
    padding: 1px 10px;
    font-size: $font_size_small;
}

QStatusBar::item {
    border: none;
}

QGroupBox {
    background: transparent;
    border: 1px solid $border;
    border-radius: $radius_card;
    margin-top: 10px;
    padding: $pad_l;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: $text_muted;
    font-weight: 600;
}
