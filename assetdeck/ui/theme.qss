/* Folha de estilo do AssetDeck.
 *
 * NÃO é um arquivo QSS comum: os "$$nome" são tokens substituídos por
 * `theme.build_qss()`. Nunca escreva uma cor literal aqui — acrescente um
 * token em `theme.py`. Um "$$" solto levanta erro na hora (de propósito);
 * para escrever um cifrão literal, dobre-o como nesta própria frase.
 *
 * Duas regras que NÃO podem ser quebradas, medidas no Qt do projeto:
 *
 *  1. NÃO estilizar `QListView::item`. Isso joga a pintura da grade para o
 *     QStyleSheetStyle item a item e mata a rolagem com centenas de assets.
 *     O visual do card é responsabilidade do delegate (Fatia 27).
 *  2. NÃO estilizar subcontrole (::drop-down, ::indicator, ::branch) sem
 *     fornecer a `image:` de reposição — a seta do combo e o quadrinho do
 *     checkbox somem. Enquanto não houver SVG (Fatia 26), eles ficam com o
 *     desenho do Fusion, que a paleta já colore corretamente.
 */

/* ---------------------------------------------------------------- base -- */

QWidget {
    color: $text;
    font-size: $font_size;
}

QMainWindow {
    background-color: $bg;
}

/* QDialog NÃO arredonda (tentado e revertido — ver theme.py). Ao contrário
 * de QMenu, um QDialog normal GANHA barra de título nativa do gerenciador de
 * janelas (minimizar/maximizar/fechar) — cortar cantos por baixo dela deixa
 * uma costura feia onde o retângulo quadrado da barra encontra o corpo
 * arredondado (visto na tela pelo Rafael). QMenu não tem esse problema (é
 * uma janela popup sem decoração nenhuma), então continua arredondado. */
QDialog {
    background-color: $bg;
}

/* Superfície de fundo da janela. É o widget central que recebe o fundo, e não
 * o QMainWindow: o QMainWindow tem tratamento próprio de fundo e deu resultado
 * inconsistente no teste. */
QWidget#appSurface {
    background-color: $bg;
    $bg_image
}

/* --------------------------------------------------------------- cards -- */

/* Até a Fatia 43 fundo e painel eram os DOIS brancos, separados só por uma
 * linha quase invisível — e a tela saía chapada. Na Fatia 44 o painel
 * ($surface) passou a ser um degrau mais claro que o fundo ($bg) no modo
 * claro, e mais claro que o quase-preto no escuro. A linha e a sombra
 * continuam, agora reforçando um degrau que já existe em vez de o inventarem
 * sozinhas.
 * Toda view (árvore, lista, grade) mora DENTRO de um destes, porque o
 * viewport de uma view pinta retângulo no canto e vaza por cima de qualquer
 * border-radius aplicado nela diretamente. */
/* Seletor SEM o tipo de propósito (Fatia 49). Era `QFrame#card`, e o
 * DetailsPanel é uma subclasse de QWidget com objectName "card" — a regra
 * nunca casou com ele, e o painel de detalhes ficou transparente desde a
 * Fatia 25. Ninguém viu porque fundo e superfície eram o mesmo branco; quando
 * a Fatia 44 separou os dois, o painel passou a mostrar o fundo da janela e o
 * Rafael relatou "sombras bugadas" — o que estava faltando era a superfície,
 * não a sombra. `#card` casa com qualquer widget que use o objectName. */
#card {
    background-color: $surface;
    border: 1px solid $hairline;
    border-radius: $radius_panel;
}

#cardFlat {
    background-color: $surface;
    border: 1px solid $border;
    border-radius: $radius_card;
}

/* Traço fino separando grupos na barra do breadcrumb (Fatia 43) — largura
 * fixa 1px definida em Python, aqui só a cor. */
QFrame#breadcrumbDivider {
    background-color: $hairline;
}

/* ---------------------------------------------- painel de detalhes (F48) -- */

/* Moldura da miniatura. Existe mesmo vazia: sem ela, um painel sem asset
 * selecionado é um buraco de 200px com um texto boiando no meio. */
QLabel#previewTile {
    background-color: $field;
    border: 1px solid $border;
    border-radius: $radius_card;
    color: $text_muted;
}

/* Ficha técnica: rótulo apagado, valor na cor do texto. O contraste entre os
 * dois é o que deixa varrer a coluna de valores sem ler os rótulos. */
QLabel#kvLabel {
    color: $text_muted;
    font-size: $font_size_small;
}

QLabel#kvValue {
    color: $text;
    font-size: $font_size_small;
}

/* Cabeçalho da lista (faixa 3 do topo, Fatia 46): o escopo em destaque e a
 * contagem apagada ao lado. O contraste entre os dois é o que faz a linha ser
 * lida como "título + apoio" em vez de duas informações concorrendo. */
QLabel#listScope {
    color: $title;
    font-size: $font_size;
    font-weight: 600;
}

QLabel#listCount {
    color: $text_muted;
    font-size: $font_size_small;
}

/* -------------------------------------------------------------- lateral -- */

/* Rail: coluna estreita de ícones, um por seção (Fatia 45). Fica no tom do
 * FUNDO, não da superfície — é ele que faz o painel das seções parecer
 * apoiado em cima de alguma coisa em vez de flutuar solto. */
QWidget#sidebarRail {
    background-color: $bg;
}

QToolButton#railButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: $radius_control;
    padding: 6px;
}

/* Borda junto do preenchimento (Fatia 76) — o rail é a "barra vertical
 * lateral" que o Rafael citou como não tendo mudado nada. Sem contorno, uma
 * pastilha clara atrás de um ícone quase não se lê. */
QToolButton#railButton:hover {
    background-color: $surface_raised;
    border: 1px solid $border;
}

/* O rail tem padding próprio (6px), então o "afundar" também é próprio: 7/5
 * mantém a soma em 12px e o ícone não muda de tamanho ao clicar. */
QToolButton#railButton:pressed {
    background-color: $surface_sunken;
    padding-top: 7px;
    padding-bottom: 5px;
}

/* Sem pastilha no estado marcado, ao contrário dos outros QToolButton do app:
 * "seção visível" é o estado normal das quatro, e acender as quatro deixaria
 * o rail permanentemente iluminado sem dizer nada. O que o rail comunica é a
 * exceção — seção escondida, ícone apagado (tingido em Python, ver
 * SidebarRail.refresh_theme). */
QToolButton#railButton:checked {
    background: transparent;
    border: 1px solid transparent;
}

/* Cabeçalho de seção: a linha inteira é clicável (recolhe/expande). */
QWidget#sidebarHeader {
    background: transparent;
    border-radius: $radius_control;
}

QWidget#sidebarHeader:hover {
    background-color: $surface_raised;
    border: 1px solid $border;
}

QLabel#sidebarSectionTitle {
    color: $text_muted;
    font-size: $font_size_small;
    font-weight: 700;
    letter-spacing: 1px;
}

/* Contador: mais apagado que o título de propósito. É informação de apoio —
 * se competir com o nome da seção, a lateral vira uma tabela de números. */
QLabel#sidebarCount {
    color: $text_disabled;
    font-size: $font_size_small;
    font-weight: 600;
}

/* QScrollArea em si (moldura/fundo do viewport é responsabilidade do Python
 * — ver `scroll.viewport().setAutoFillBackground(False)` em details_panel.py;
 * o seletor `QScrollArea > QWidget` do QSS NÃO alcança o viewport de forma
 * confiável, então não dá pra resolver só daqui). */
QScrollArea {
    background: transparent;
    border: none;
}

/* ---------------------------------------------------------------- texto -- */

QLabel {
    background: transparent;
}

QLabel#sectionTitle {
    color: $text_muted;
    font-size: $font_size_small;
    font-weight: 600;
}

QLabel#title {
    color: $title;
    font-size: $font_size_title;
    font-weight: 600;
}

QLabel#muted, QLabel#previewInfo {
    color: $text_muted;
}

QLabel#multiWarn {
    color: $warning;
    font-weight: 600;
}

QLabel#danger {
    color: $danger;
}

QLabel:disabled {
    color: $text_disabled;
}

/* -------------------------------------------------------------- campos -- */

QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QDateEdit {
    background-color: $field;
    border: 1px solid $border;
    border-radius: $radius_control;
    padding: $pad_m;
    color: $text;
    selection-background-color: $accent;
    selection-color: $on_accent;
}

QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus {
    border: 1px solid $focus;
}

QLineEdit:disabled, QPlainTextEdit:disabled, QTextEdit:disabled {
    color: $text_disabled;
}

/* -------------------------------------------------------------- botões -- */

QPushButton, QToolButton {
    background-color: $surface;
    border: 1px solid $border;
    border-radius: $radius_control;
    padding: $pad_m $pad_l;
    color: $text;
}

/* Hover e clique usam os DEGRAUS DE ELEVAÇÃO (Fatia 75), os mesmos do card da
 * grade — "levantado" e "afundado" querem dizer a mesma coisa em qualquer
 * lugar da tela. Antes eram `$surface_hover`/`$selection`, véus de 3,5% e 6,5%
 * de preto: quase invisíveis, e a razão de o app parecer não responder ao
 * mouse. O Qt não anima QSS (não existe `transition` aqui, ao contrário do CSS
 * da web), então o estado precisa ser LEGÍVEL de imediato — quem tem animação
 * de verdade é o card, que é pintado à mão por um delegate.
 *
 * A borda destes estados é `$border`, a MESMA do repouso — e não `$hairline`,
 * como era até a Fatia 75. `$hairline` (7,5% de preto) é mais fraco que
 * `$border` (9%), ou seja: o contorno do botão ENFRAQUECIA justamente quando o
 * mouse chegava, empurrando na direção contrária do preenchimento. Visto num
 * mostruário dos estados lado a lado, que é a única forma de comparar isso —
 * num screenshot normal nenhum botão está em hover. */
QPushButton:hover, QToolButton:hover {
    background-color: $surface_raised;
    border: 1px solid $border;
}

/* Pressionado (transitório) segue monocromático: é um flash de meio segundo,
 * não vale acender o destaque. O padding assimétrico empurra o conteúdo 1px
 * pra baixo — o botão "afunda" sob o dedo. A SOMA continua igual à do estado
 * normal ($pad_m em cima e embaixo), então o tamanho do botão não muda e nada
 * na tela se reposiciona ao clicar. */
QPushButton:pressed, QToolButton:pressed {
    background-color: $surface_sunken;
    border: 1px solid $border;
    color: $text;
    padding-top: 9px;
    padding-bottom: 7px;
}

/* Marcado (persistente) é pastilha azul com o texto no destaque — Fatia 44.
 * É o estado que responde "qual filtro está ligado agora": era cinza sobre
 * cinza, e o Rafael não conseguia dizer, olhando a barra de categorias, o que
 * estava ativo. Aqui o azul carrega informação, que é a única condição em que
 * este projeto gasta cor. */
QPushButton:checked, QToolButton:checked {
    background-color: $accent_soft;
    border: 1px solid transparent;
    color: $accent;
    font-weight: 600;
}

QPushButton:disabled, QToolButton:disabled {
    color: $text_disabled;
    background-color: $surface;
}

/* Só UM botão principal por tela (é o que dá hierarquia). */
QPushButton#primary {
    background-color: $accent;
    border: 1px solid $accent;
    color: $on_accent;
    font-weight: 600;
}

QPushButton#primary:hover {
    background-color: $accent_hover;
    border: 1px solid $accent_hover;
}

QPushButton#primary:pressed {
    background-color: $accent_press;
    border: 1px solid $accent_press;
    padding-top: 9px;
    padding-bottom: 7px;
}

/* Desabilitado PRECISA estar aqui, repetindo o que `QPushButton:disabled` já
 * diz (Fatia 74). Não é redundância: `QPushButton#primary` é seletor de ID e
 * ganha de `QPushButton:disabled` (pseudo-classe) na especificidade, então o
 * botão principal continuava pintado de destaque mesmo desligado. Dava pra
 * ver no painel de detalhes sem asset nenhum selecionado: "Abrir pasta"
 * aparecia corretamente apagado ao lado de um "Abrir com app padrão" que
 * parecia clicável. Achado na revisão visual da Fase 7 — o bug é antigo, só
 * ficou gritante quando o destaque virou laranja. */
QPushButton#primary:disabled {
    background-color: $surface;
    border: 1px solid $border;
    color: $text_disabled;
}

/* Pastilha totalmente arredondada (Fatia 76): botões de categoria (objetos,
 * materiais, imagens…) e de filtro (ordenar, resolução, cor). Pedido do
 * Rafael — "os botões de filtragem por tipo deveriam ser totalmente
 * arredondados" —, estendido aos de filtro pra barra de cima não ficar com
 * duas famílias de forma concorrendo.
 *
 * O raio é grande de propósito em vez de "metade da altura": a altura muda com
 * a fonte e com o tema, e o Qt corta o raio no máximo que couber. Precisa
 * repetir hover/clique/marcado aqui porque `#pill` é seletor de ID e ganha das
 * regras genéricas — sem isso o botão voltaria a ser quadrado justamente ao
 * passar o mouse (a mesma armadilha do `#primary:disabled`, Fatia 74, agora
 * coberta por teste). */
QToolButton#pill {
    border-radius: $radius_pill;
    padding: $pad_m $pad_l;
}

QToolButton#pill:hover {
    background-color: $surface_raised;
    border: 1px solid $border;
    border-radius: $radius_pill;
}

QToolButton#pill:pressed {
    background-color: $surface_sunken;
    border: 1px solid $border;
    border-radius: $radius_pill;
    padding-top: 9px;
    padding-bottom: 7px;
}

QToolButton#pill:checked {
    background-color: $accent_soft;
    border: 1px solid transparent;
    border-radius: $radius_pill;
    color: $accent;
    font-weight: 600;
}

/* A setinha do menu (categoria) fica no MESMO retângulo arredondado; sem isto
 * o Qt desenha o pedaço dela com canto reto e a pastilha aparece "mordida" do
 * lado direito. Só geometria — nenhum `image:` é trocado, então a seta que o
 * Fusion desenha continua lá (ver a regra 2 do cabeçalho deste arquivo). */
QToolButton#pill::menu-button {
    border: none;
    border-top-right-radius: $radius_pill;
    border-bottom-right-radius: $radius_pill;
    width: 16px;
}

/* A setinha do popup instantâneo (ordenar/resolução/cor) é desenhada no canto
 * inferior-direito do retângulo — que numa pastilha é justamente onde a curva
 * já cortou o fundo, então ela ficava PENDURADA PRA FORA do botão. Puxada pra
 * dentro, encostada na direita e centrada na vertical.
 *
 * `subcontrol-position` é geometria: não troca `image:`, então a seta que o
 * Fusion desenha continua existindo (é a ressalva do cabeçalho deste arquivo,
 * conferida na tela — ver `zoom` da Fatia 76). */
QToolButton#pill::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    right: 4px;
    width: 10px;
}

/* Botão sem moldura, para ações discretas (estrelas, ícones do painel). */
QPushButton#ghost, QToolButton#ghost {
    background: transparent;
    border: 1px solid transparent;
}

QPushButton#ghost:hover, QToolButton#ghost:hover {
    background-color: $surface_raised;
    border: 1px solid $border;
}

/* Precisa existir mesmo repetindo o `QPushButton:pressed` genérico: `#ghost` é
 * seletor de ID e ganha dele na especificidade (mesma armadilha do
 * `#primary:disabled`, Fatia 74). Sem isto o botão sem moldura ficava com o
 * hover parado durante o clique — nenhum sinal de que apertou. */
QPushButton#ghost:pressed, QToolButton#ghost:pressed {
    background-color: $surface_sunken;
    border: 1px solid $border;
    padding-top: 9px;
    padding-bottom: 7px;
}

QCheckBox, QRadioButton {
    background: transparent;
    color: $text;
    spacing: 7px;
    padding: 2px 0;
}

/* Barra de busca (Fatia 28d): controles mais baixos SÓ aqui — pedido do
 * Rafael de enxutar verticalmente. objectName próprio, não afeta o resto
 * do app. */
#searchBar QLineEdit, #searchBar QPushButton {
    padding: 4px 10px;
}

/* A barra de busca é mais baixa que o resto (4px de padding), então o
 * "afundar" precisa da conta dela: 5/3 soma os mesmos 8px. Sem esta regra o
 * `QPushButton:pressed` genérico não chegaria aqui — `#searchBar QPushButton`
 * tem seletor de ID e ganha dele. */
#searchBar QPushButton:pressed {
    padding-top: 5px;
    padding-bottom: 3px;
}

#searchBar QCheckBox {
    padding: 0;
}

QCheckBox:disabled, QRadioButton:disabled {
    color: $text_disabled;
}

/* Exceção consciente à regra "não estilizar subcontrole sem repor a image:".
 * Com a paleta clara, o indicador que o Fusion desenha usa a cor de botão —
 * quase branco sobre quase branco — e a caixa DESMARCADA fica invisível na
 * tela. Aqui o estado é legível pelo preenchimento: cheio da cor de destaque =
 * marcado, vazio com borda = desmarcado.
 *
 * O fundo da caixa VAZIA era "#FFFFFF" cravado aqui — branco puro no meio de
 * uma janela quase preta, um confete aceso em cada checkbox do modo escuro
 * (Fatia 44). Agora é o token do campo, que acompanha o modo. */
QCheckBox::indicator, QRadioButton::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid $border_strong;
    background-color: $field;
}

QCheckBox::indicator {
    border-radius: 4px;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border: 1px solid $focus;
}

QCheckBox::indicator:checked {
    background-color: $accent;
    border: 1px solid $accent;
    image: url($check_icon);
}

/* Radio marcado é um ponto sólido, não um "✓" — a checkmark cairia estranho
 * dentro de um círculo. */
QRadioButton::indicator:checked {
    background-color: $accent;
    border: 1px solid $accent;
}

QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    border: 1px solid $border;
    background-color: $bg_tint;
}

/* O MESMO indicador, mas para os checkboxes DENTRO de árvores/listas/tabelas
 * (tags do painel de detalhes, TagTree lateral, DuplicatesDialog). É um
 * subcontrole diferente de QCheckBox::indicator — sem esta regra ele cai no
 * desenho genérico do QStyleSheetStyle assim que QUALQUER stylesheet está
 * ativo, que sai um quadrado preto sólido, marcado ou não (bug relatado pelo
 * Rafael, visto na tela: tags_tree do painel de detalhes). QTableView entrou
 * junto — mesmo bug, achado no DuplicatesDialog. */
QTreeView::indicator, QListView::indicator, QTableView::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid $border_strong;
    background-color: $field;
    border-radius: 4px;
}

QTreeView::indicator:checked, QListView::indicator:checked, QTableView::indicator:checked {
    background-color: $accent;
    border: 1px solid $accent;
    image: url($check_icon);
}

QTreeView::indicator:disabled, QListView::indicator:disabled, QTableView::indicator:disabled {
    border: 1px solid $border;
    background-color: $bg_tint;
}

QComboBox {
    background-color: $surface;
    border: 1px solid $border;
    border-radius: $radius_control;
    padding: $pad_m $pad_l;
    color: $text;
}

QComboBox:hover {
    background-color: $surface_raised;
}

QComboBox:focus {
    border: 1px solid $focus;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox::down-arrow {
    image: url($chevron_icon);
    width: 11px;
    height: 11px;
}

/* O popup do combo é uma JANELA separada: não herda o fundo do card e
 * ficaria branco-padrão sem esta regra. */
QComboBox QAbstractItemView {
    background-color: $popover;
    border: 1px solid $border;
    border-radius: $radius_control;
    padding: $pad_s;
    color: $text;
    selection-background-color: $selection;
    selection-color: $text;
    outline: none;
}

/* --------------------------------------------------------------- views -- */

/* Fundo transparente porque quem pinta a superfície é o QFrame#card em volta.
 * `QListView` aparece aqui só para zerar moldura e fundo — nunca com ::item. */
QTreeView, QTreeWidget, QListView, QListWidget, QTableView, QTableWidget {
    background: transparent;
    border: none;
    color: $text;
    outline: none;
    selection-background-color: $selection;
    selection-color: $text;
}

/* A borda entra JÁ AQUI, transparente, e o padding é 1px menor dos dois lados
 * (Fatia 76). Assim o estado de hover pode acender a borda sem que a caixa de
 * conteúdo encolha — texto e ícone ficam exatamente no mesmo lugar nos dois
 * estados. Somar borda só no `:hover` empurraria a linha inteira 1px. */
QTreeView::item, QListWidget::item, QTableView::item {
    padding: 3px 5px;
    border: 1px solid transparent;
}

/* O Rafael, olhando a lateral: "os botões da janela de pastas, tags, barra
 * vertical lateral parecem ter mudado nada... nem borda possui". O
 * preenchimento do hover JÁ funcionava (medido com mouse real: #FFFFFF →
 * #EFEFF4), mas sozinho ele é discreto demais numa lista de muitas linhas —
 * o que dá contorno de "isto aqui é clicável" é a borda. */
QTreeView::item:hover, QListWidget::item:hover, QTableView::item:hover {
    background-color: $surface_raised;
    border: 1px solid $border;
}

/* Seleção em pastilha CLARA com o texto na cor, como os botões ativos do
 * painel direito do Craft. A barra sólida de petróleo que estava aqui antes
 * dominava a tela inteira — foi o que o Rafael reprovou.
 *
 * Fatia 76: a pastilha cinza virou a de DESTAQUE. É o que `theme.py` já dizia
 * ser o papel do `accent_soft` ("estado ativo... usado onde não há imagem
 * embaixo — lateral, filtros") e o que a direção visual aprovada da Fase 7
 * pedia ("sidebar com item ativo em pastilha preenchida"). Não é a barra
 * sólida reprovada lá atrás: aquela era petróleo cheio ocupando a lista
 * inteira; esta é laranja lavado com o texto no destaque, mesmo par de cores
 * dos filtros ativos — e o contraste dele está travado em `test_theme.py`. */
QTreeView::item:selected, QListWidget::item:selected, QTableView::item:selected {
    background-color: $accent_soft;
    color: $accent;
    border: 1px solid transparent;
    font-weight: 600;
}

/* Seleção arredondada só onde NÃO há coluna de indicador (as listas).
 * Na árvore, o indicador de expandir é pintado quadrado pelo estilo e fica um
 * degrau visível ao lado do item arredondado — medido pixel a pixel. Estilizar
 * `QTreeView::branch` para corrigir é pior: o Qt volta a pintar a seleção com
 * o azul padrão dele. Então a árvore usa barra de linha inteira, de propósito. */
QListWidget::item {
    border-radius: $radius_control;
}

QHeaderView::section {
    background-color: $bg_tint;
    border: none;
    border-bottom: 1px solid $border;
    padding: 6px 8px;
    color: $text_muted;
    font-weight: 600;
}

/* --------------------------------------------------------------- menus -- */

QMenuBar {
    background: transparent;
    color: $text;
}

/* Marca e contexto ocupam os cantos da MESMA faixa dos menus (Fatia 50) —
 * ver `MainWindow._setup_brand_bar` para por que as abas do mockup ficaram
 * de fora. */
QFrame#brandDot {
    background-color: $accent;
    border-radius: 2px;
}

QLabel#brandName {
    color: $title;
    font-size: $font_size;
    font-weight: 700;
}

/* Contexto (biblioteca aberta e modo) é apoio: apagado de propósito, para não
 * competir com os menus, que são o que se clica nesta faixa. */
QLabel#brandContext {
    color: $text_muted;
    font-size: $font_size_small;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 10px;
    border-radius: $radius_control;
}

QMenuBar::item:selected {
    background-color: $surface_raised;
}

QMenu {
    background-color: $popover;
    border: 1px solid $border;
    border-radius: $radius_card;
    padding: $pad_s;
    color: $text;
}

QMenu::item {
    padding: 6px 22px 6px 12px;
    border-radius: $radius_control;
}

QMenu::item:selected {
    background-color: $selection;
    color: $text;
}

QMenu::item:disabled {
    color: $text_disabled;
}

QMenu::separator {
    height: 1px;
    background-color: $border;
    margin: 5px 8px;
}

QToolTip {
    background-color: $popover;
    border: 1px solid $border;
    border-radius: $radius_control;
    padding: 5px 8px;
    color: $text;
}

/* ------------------------------------------------------------- rolagem -- */

QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 0;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background-color: $bg_tint;
    border-radius: 6px;
    min-height: 32px;
    min-width: 32px;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background-color: $selection;
}

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* ------------------------------------------------------------- diversos -- */

/* Barra fina e SEM texto por dentro: a porcentagem escrita por cima do trecho
 * preenchido fica com contraste de 2,4:1 contra o petróleo — ilegível. Quem
 * precisar do número escreve num QLabel ao lado. */
QProgressBar {
    background-color: $bg_tint;
    border: none;
    border-radius: 5px;
    min-height: 10px;
    max-height: 10px;
    color: $text_muted;
}

QProgressBar::chunk {
    background-color: $accent;
    border-radius: 5px;
}

/* Slider de tamanho da miniatura (Fatia 28c): trilho fino, trecho
 * preenchido na cor de destaque — minimalista, sem o relevo 3D padrão do
 * Fusion. Fatia 56: a alça deixou de ser uma bolinha 16×16 flutuando
 * (destoava dos botões ícone-only ao lado, agora que o slider mudou do
 * rodapé pra faixa de nota/resolução/cor) — virou um traço fino e baixo,
 * do mesmo jeito "achatado" da trilha, não um raio de $radius_control
 * (que arredondaria demais numa alça deste tamanho e voltaria a parecer
 * bola). */
QSlider::groove:horizontal {
    height: 4px;
    background: $bg_tint;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: $accent;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 6px;
    height: 14px;
    margin: -5px 0;
    background: $surface;
    border: 1px solid $border_strong;
    border-radius: 2px;
}

QSlider::handle:horizontal:hover {
    background: $accent;
    border: 1px solid $accent;
}

QSplitter::handle {
    background: transparent;
}

QSplitter::handle:hover {
    background-color: $selection;
}

/* Compacto de propósito (pedido do Rafael): é uma linha de status, não
 * precisa da altura padrão do Fusion. */
QStatusBar {
    background: transparent;
    color: $text_muted;
    padding: 1px 10px;
    font-size: $font_size_small;
}

QStatusBar::item {
    border: none;
}

QGroupBox {
    background: transparent;
    border: 1px solid $border;
    border-radius: $radius_card;
    margin-top: 10px;
    padding: $pad_l;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: $text_muted;
    font-weight: 600;
}
